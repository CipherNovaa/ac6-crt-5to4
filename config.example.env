# Copy to config.env, edit, then:  set -a; . ./config.env; set +a
# Every value is optional; the defaults match a stock Steam-on-Linux install.

# The game's Game/ folder and its Proton prefix
AC6_GAME_DIR="$HOME/.local/share/Steam/steamapps/common/ARMORED CORE VI FIRES OF RUBICON/Game"
AC6_PREFIX="$HOME/.local/share/Steam/steamapps/compatdata/1888160/pfx"

# Where the launcher parks the genuine EAC exe, the DXVK dxgi copy and stripped mod files
AC6_STATE_DIR="$HOME/.local/share/ac6-crt-5to4"
# md5sum of your genuine start_protected_game.exe (the online gate refuses to launch without it)
AC6_GENUINE_EAC_MD5=""

# Hyprland: the CRT's output name, monitor id, and a workspace that lives on it
AC6_CRT_OUTPUT="HDMI-A-1"
AC6_CRT_MONITOR_ID="0"
AC6_CRT_WORKSPACE="11"

# Third-party tools (downloaded separately, see README)
AC6_ME3_DIR="./ui/tools/me3"
AC6_FFDEC="./ui/tools/ffdec/ffdec.sh"

# Steam account config (only needed if you have more than one Steam account on the machine)
# STEAM_LOCALCONFIG="$HOME/.local/share/Steam/userdata/<account id>/config/localconfig.vdf"
